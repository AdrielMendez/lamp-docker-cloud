{
  "name": "LAMP Stack",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "apache",
  "workspaceFolder": "/workspace",
  "forwardPorts": [8080, 8081, 3306],
  "portsAttributes": {
    "8080": {
      "label": "Apache",
      "onAutoForward": "openPreview"
    },
    "8081": {
      "label": "phpMyAdmin",
      "onAutoForward": "openPreview"
    },
    "3306": {
      "label": "MySQL"
    }
  },
  "postCreateCommand": "docker-compose up -d"
}
